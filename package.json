{
  "name": "@1337exp/2pack",
  "version": "2.0.1",
  "description": "Tiny schema-first binary codec for Node and browsers: typed, bounds-checked, zero dependencies. You own the buffer.",
  "keywords": [
    "binary",
    "serialization",
    "codec",
    "schema",
    "packet",
    "websocket",
    "typescript",
    "gamedev"
  ],
  "type": "module",
  "homepage": "https://666.io",
  "bugs": {
    "url": "https://github.com/1337exp/2pack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/2pack.git"
  },
  "author": "1337exp",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node scripts/mutate.mjs . scripts/mutations.json",
    "bench": "npm run build && node scripts/bench.mjs",
    "browser": "node scripts/browser.mjs",
    "backpressure": "npm run build && node examples/backpressure.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "cbor-x": "^1.6.9",
    "msgpackr": "^2.1.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
